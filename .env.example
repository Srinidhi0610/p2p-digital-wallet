# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wallet_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Alternatively, define the full JDBC URL:
# DB_URL=jdbc:postgresql://localhost:5432/wallet_db

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
